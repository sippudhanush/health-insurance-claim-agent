@startuml
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center

title Health Insurance Claim Agent

actor Member as MEMBER
actor "Ops Team" as OPS

box "Frontend" #E8F4FD
  participant "Streamlit UI" as UI
end box

box "Backend API" #F0E6FF
  participant "FastAPI" as API
  participant "Orchestrator" as ORCH
end box

box "Sub-Agents" #E8FFE8
  participant "verify_documents" as V
  participant "extract_documents" as E
  participant "check_policy" as P
  participant "detect_fraud" as F
  participant "decide_claim" as D
end box

box "Infrastructure" #FFF3E0
  entity "policy_terms.json" as POLICY
  entity "OpenAI" as LLM
  entity "Traces" as TRACES
end box

== 1. Submit ==
MEMBER -> UI: Upload docs + claim details
UI -> API: POST /api/claims (base64 files)
API -> ORCH: process_claim(payload)

== 2. Policy ==
ORCH -> POLICY: Load policy_terms.json
ORCH -> ORCH: Build payload with member + policy

== 3. Agent Loop ==
ORCH -> LLM: trace() + Runner.run()
note right #F0E6FF
  Orchestrator has 5 tools.
  LLM decides call order.
  Full trace sent to OpenAI.
end note

ORCH -> V: 1. verify_documents
note right #E8FFE8
  Sub-agent classifies docs,
  checks requirements from policy.
end note
V --> ORCH: valid, missing, wrong

alt Failed
  ORCH --> API: Error
  API --> UI: Show specific error
else Passed
end

ORCH -> E: 2. extract_documents
E -> LLM: Vision API (base64 images)
LLM --> E: Patient, diagnosis, items, total
E --> ORCH: extracted data

ORCH -> P: 3. check_policy
note right #E8FFE8
  Waiting period, sub-limit,
  exclusions, pre-auth,
  network discount, co-pay.
  Line-item level exclusion check.
end note
P --> ORCH: eligible, approved_amount, breakdown

ORCH -> F: 4. detect_fraud
F --> ORCH: fraud_score, signals

ORCH -> D: 5. decide_claim
D --> ORCH: Final decision + confidence

== 4. Result ==
ORCH --> API: Final JSON
API --> UI: decision, amount, trace, breakdown

alt Manual Review
  UI --> OPS: Flagged for review
  OPS -> API: GET /api/claims/{id}
  API --> OPS: Full trace
else Approved/Partial/Rejected
  UI --> MEMBER: Show decision + reasoning
end

== 5. Traces ==
OPS -> TRACES: View at platform.openai.com/traces
UI -> UI: Show trace in expandable JSON

@enduml
